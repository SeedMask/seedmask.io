---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="footer-brand-row" href="/">
        <span class="brand-mark footer-mark">
          <img src="/branding/seedmask-mark.png" alt="" width="36" height="36" />
        </span>
        <strong>SeedMask</strong>
      </a>
      <a
        class="social-link footer-social"
        href="https://x.com/Seedmask"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="SeedMask on X"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"
          ><path
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L2.25 2.25h6.093l4.261 5.691L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644z"
          ></path></svg
        >
      </a>
    </div>
    <div class="footer-col">
      <h4>Product</h4>
      <a href="/products">Hardware</a>
      <a href="/app">Coordinator</a>
      <a href="/products">Coming soon</a>
    </div>
    <div class="footer-col">
      <h4>Features</h4>
      <a href="/features">SeedMask Features</a>
      <a href="/features/firmware">Firmware</a>
    </div>
    <div class="footer-col">
      <h4>Learn</h4>
      <a href="/learn/basic-crypto">Basic crypto know-how</a>
      <a href="/learn/tutorials">Tutorials</a>
      <a href="/learn/blog">Blog</a>
    </div>
    <div class="footer-col">
      <h4>Company</h4>
      <a href="/about">About</a>
      <a href="/learn">Learn hub</a>
      <a href="/disclaimer">Disclaimer</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} SeedMask</span>
    <span>Bitcoin &amp; Kaspa-only hardware wallet</span>
  </div>
</footer>
