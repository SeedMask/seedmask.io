---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="footer-brand-row" href="/">
        <span class="brand-mark footer-mark">
          <img src="/branding/seedmask-mark.png" alt="" width="36" height="36" />
        </span>
        <strong>SeedMask</strong>
      </a>
      <div class="footer-channels">
        <a
          class="channel-btn"
          href="https://x.com/Seedmask"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="SeedMask on X"
