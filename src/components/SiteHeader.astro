---

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="header-shell">
    <a class="brand-link" href="/">
      <span class="brand-mark">
        <img src="/branding/seedmask-mark-header.png" alt="" width="46" height="46" />
      </span>
      <span class="brand-word">SeedMask</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <div class="nav-item">
        <a class={`nav-trigger${path.startsWith('/products') ? ' active' : ''}`} href="/products">Products</a>
        <div class="mega mega-products mega-products-wide" role="menu">
          <a class="mega-product-card" href="/products/hardware">
            <img src="/illustrations/products-hardware.png" alt="" />
            <strong>SeedMask hardware</strong>
            <span><em class="mega-coming-soon">Coming soon</em> — Bitcoin &amp; Kaspa-only cold storage. Air-gapped by design.</span>
          </a>
          <a class="mega-product-card" href="/app">
            <img src="/illustrations/products-coordinator.png" alt="" />
            <strong>SeedMask Coordinator</strong>
            <span>Watch-only desktop companion for balances and signing payloads</span>
          </a>
        </div>
      </div>
      <a class={`nav-link${path === '/app' ? ' active' : ''}`} href="/app">App</a>
      <div class="nav-item">
        <a class={`nav-trigger${path.startsWith('/learn') ? ' active' : ''}`} href="/learn">Learn</a>
        <div class="mega mega-learn mega-learn-wide" role="menu">
          <a class="mega-learn-card" href="/learn/basic-crypto">
            <img src="/illustrations/learn-basics.png" alt="" />
            <strong>Basic crypto know-how</strong>
            <span>Keys, wallets, and self-custody fundamentals</span>
          </a>
          <a class="mega-learn-card" href="/learn/tutorials">
            <img src="/illustrations/learn-tutorials-3.png" alt="" />
            <strong>SeedMask tutorials</strong>
            <span>Hardware preview, Coordinator, and air-gapped signing</span>
          </a>
          <a class="mega-learn-card" href="/learn/blog">
            <img src="/illustrations/learn-blog.png" alt="" />
            <strong>Blog</strong>
            <span>Product direction and security notes</span>
          </a>
        </div>
      </div>
      <div class="nav-item">
        <a class={`nav-trigger${path.startsWith('/features') ? ' active' : ''}`} href="/features">Features</a>
        <div class="mega mega-features mega-features-wide" role="menu">
          <a class="mega-feature-card" href="/features/firmware">
            <img src="/illustrations/features-firmware-10.png" alt="" />
            <strong>Firmware</strong>
            <span>Download and verify SeedMask device firmware</span>
          </a>
          <a class="mega-feature-card" href="/features/device">
            <img src="/illustrations/features-device.png" alt="" />
            <strong>SeedMask Features</strong>
            <span>Password manager, notes, 2FA, air gap, backup, duress &amp; more</span>
          </a>
        </div>
      </div>
      <a class={`nav-link${path === '/about' ? ' active' : ''}`} href="/about">About</a>
    </nav>

    <div class="header-actions">
      <button
        class="menu-toggle"
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="nav-mobile"
        aria-label="Open menu"
      >
        <span class="burger" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <nav class="nav-mobile" id="nav-mobile" aria-label="Mobile">
    <details class="nav-mobile-section">
      <summary>Products</summary>
      <div class="nav-mobile-mega nav-mobile-products">
        <a class="mega-product-card" href="/products/hardware">
          <img src="/illustrations/products-hardware.png" alt="" />
          <strong>SeedMask hardware</strong>
          <span><em class="mega-coming-soon">Coming soon</em> — Bitcoin &amp; Kaspa-only cold storage. Air-gapped by design.</span>
        </a>
        <a class="mega-product-card" href="/app">
          <img src="/illustrations/products-coordinator.png" alt="" />
          <strong>SeedMask Coordinator</strong>
          <span>Watch-only desktop companion for balances and signing payloads</span>
        </a>
      </div>
    </details>

    <a class="nav-mobile-link" href="/app">App</a>

    <details class="nav-mobile-section">
      <summary>Learn</summary>
      <div class="nav-mobile-mega nav-mobile-learn">
        <a class="mega-learn-card" href="/learn/basic-crypto">
          <img src="/illustrations/learn-basics.png" alt="" />
          <strong>Basic crypto know-how</strong>
          <span>Keys, wallets, and self-custody fundamentals</span>
        </a>
        <a class="mega-learn-card" href="/learn/tutorials">
          <img src="/illustrations/learn-tutorials-3.png" alt="" />
          <strong>SeedMask tutorials</strong>
          <span>Hardware preview, Coordinator, and air-gapped signing</span>
        </a>
        <a class="mega-learn-card" href="/learn/blog">
          <img src="/illustrations/learn-blog.png" alt="" />
          <strong>Blog</strong>
          <span>Product direction and security notes</span>
        </a>
      </div>
    </details>

    <details class="nav-mobile-section">
      <summary>Features</summary>
      <div class="nav-mobile-mega nav-mobile-features">
        <a class="mega-feature-card" href="/features/firmware">
          <img src="/illustrations/features-firmware-10.png" alt="" />
          <strong>Firmware</strong>
          <span>Download and verify SeedMask device firmware</span>
        </a>
        <a class="mega-feature-card" href="/features/device">
          <img src="/illustrations/features-device.png" alt="" />
          <strong>SeedMask Features</strong>
          <span>Password manager, notes, 2FA, air gap, backup, duress &amp; more</span>
        </a>
      </div>
    </details>

    <a class="nav-mobile-link" href="/about">About</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const panel = document.getElementById('nav-mobile');
  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('open');
    toggle.classList.toggle('is-open', Boolean(open));
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });

  // Keep desktop mega menus open briefly on diagonal leave; only one open at a time
  const navItems = [...document.querySelectorAll('.nav-desktop .nav-item')];
  navItems.forEach((item) => {
    let closeTimer = 0;
    const open = () => {
      window.clearTimeout(closeTimer);
      navItems.forEach((other) => {
        if (other !== item) {
          window.clearTimeout(/** @type {any} */ (other)._megaCloseTimer || 0);
          other.classList.remove('is-open');
        }
      });
      item.classList.add('is-open');
    };
    const scheduleClose = () => {
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => item.classList.remove('is-open'), 160);
      /** @type {any} */ (item)._megaCloseTimer = closeTimer;
    };
    item.addEventListener('pointerenter', open);
    item.addEventListener('pointerleave', scheduleClose);
    item.addEventListener('focusin', open);
    item.addEventListener('focusout', (e) => {
      if (!item.contains(/** @type {Node | null} */ (e.relatedTarget))) scheduleClose();
    });
  });
</script>
