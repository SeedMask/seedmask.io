---
interface Props {
  compact?: boolean;
  caption?: boolean;
  captionLabel?: string;
  alive?: boolean;
  class?: string;
  src?: string;
}
const {
  compact = false,
  caption = true,
  captionLabel = '4″ touchscreen',
  class: className = '',
  src = '/illustrations/device-35.png',
} = Astro.props;
---

<figure
  class={`device-photo${compact ? ' device-photo-compact' : ''}${className ? ` ${className}` : ''}`}
  aria-hidden="true"
>
  <div class="device-photo-frame">
    <img src={src} alt="" width="840" height="560" />
  </div>
  {caption && !compact && <figcaption>{captionLabel}</figcaption>}
</figure>
