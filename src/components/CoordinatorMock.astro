---
---

<div class="coord-scale">
  <div class="coord-mock" aria-hidden="true">
    <div class="coord-titlebar">
      <div class="coord-traffic">
        <span class="coord-dot"></span>
        <span class="coord-dot"></span>
        <span class="coord-dot"></span>
      </div>
      <span class="coord-window-title">SeedMask Coordinator</span>
    </div>
    <div class="coord-shell">
      <aside class="coord-side">
        <div class="coord-brand">
          <img src="/branding/seedmask-mark.png" alt="" />
          <span>SeedMask</span>
        </div>
        <div class="coord-chain">
          <span class="coord-chain-tile is-active">
            <img src="/branding/kaspa-kas-logo.png" alt="" />
            Kaspa
          </span>
          <span class="coord-chain-tile">
            <img src="/branding/bitcoin-btc-logo.png" alt="" />
            Bitcoin
          </span>
        </div>
        <nav class="coord-nav">
          <span class="coord-nav-item is-active">Dashboard</span>
          <span class="coord-nav-item">Addresses</span>
          <span class="coord-nav-item">Coins</span>
          <span class="coord-nav-item">Wallet settings</span>
        </nav>
        <div class="coord-side-foot">
          <span class="coord-nav-item">System settings</span>
          <span class="coord-status">Synced · v1.0.8</span>
        </div>
      </aside>
      <div class="coord-column">
        <div class="coord-strip">
          <span class="coord-chip is-active">
            <span class="coord-chip-mark"></span>
            Travel Fund
            <em>100K</em>
          </span>
          <span class="coord-chip">
            <span class="coord-chip-mark"></span>
            Savings
            <em>25K</em>
          </span>
          <span class="coord-chip-add">+</span>
        </div>
        <div class="coord-content">
          <div class="coord-hero-card">
            <div class="coord-hero-top">
              <div>
                <p class="coord-hero-title">Travel Fund <span>Balance</span></p>
                <p class="coord-hero-sub">Watch-only · Account 0</p>
              </div>
              <span class="coord-account">Account 0</span>
            </div>
            <div class="coord-balance-row">
              <span class="coord-balance">100,000.00</span>
              <span class="coord-unit">KAS</span>
            </div>
            <p class="coord-fiat">≈ $2,800.00</p>
            <div class="coord-actions">
              <span class="coord-action">Send</span>
              <span class="coord-action">Receive</span>
            </div>
          </div>
          <div class="coord-tx-block">
            <div class="coord-tx-head">
              <strong>Transactions</strong>
              <span>Recent activity</span>
            </div>
            <div class="coord-tx-row">
              <div>
                <strong>Payroll</strong>
                <span>Received · Confirmed</span>
              </div>
              <em class="in">+250.00000000</em>
            </div>
            <div class="coord-tx-row">
              <div>
                <strong>Coffee</strong>
                <span>Sent · Confirmed</span>
              </div>
              <em class="out">−40.00000000</em>
            </div>
            <div class="coord-tx-row">
              <div>
                <strong>Transfer in</strong>
                <span>Received · Confirmed</span>
              </div>
              <em class="in">+120.50000000</em>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const DESIGN_W = 920;

  function syncCoordStages() {
    document.querySelectorAll('.coord-stage').forEach((stage) => {
      const width = stage.clientWidth || DESIGN_W;
      const scale = Math.min(1, width / DESIGN_W);
      stage.style.setProperty('--coord-s', String(scale));
      stage.classList.toggle('is-scaled', scale < 0.999);
    });
  }

  syncCoordStages();
  window.addEventListener('resize', syncCoordStages, { passive: true });
</script>
