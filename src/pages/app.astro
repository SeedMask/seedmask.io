---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoordinatorMock from '../components/CoordinatorMock.astro';
import ComingSoonButton from '../components/ComingSoonButton.astro';

const downloads = {
  macArm:
    'https://github.com/SeedMask/coordinator/releases/download/v1.0.2/SeedMask-Coordinator-1.0.2-arm64.dmg',
  version: '1.0.2',
};
---

<BaseLayout
  title="App — SeedMask Coordinator"
  description="Download SeedMask Coordinator — watch-only desktop app for Bitcoin and Kaspa. Build transactions on your computer. Sign on your SeedMask device. Run your own node."
>
  <section class="page-hero">
    <div class="container">
      <div class="app-hero-head">
        <h1>SeedMask Coordinator</h1>
        <aside class="audit-banner audit-banner-hero" role="note">
          <strong>Not audited yet.</strong>
          <p>
            Coordinator is watch-only and never holds your seed. Treat it as early software until a third-party audit lands.
          </p>
        </aside>
      </div>
      <p class="tut-hero-lead">A <strong>Kaspa-first</strong> watch-only desktop app.</p>
      <p class="tut-hero-lead">
        See balances, manage addresses and coins, and prepare unsigned transactions — without ever holding your keys.
      </p>
      <div class="hero-actions app-hero-actions">
        <a class="btn btn-primary" href="#download">Download</a>
      </div>
      <div class="coord-intro">
        <p class="eyebrow">Interface</p>
        <h2 class="section-title">Watch-only by architecture</h2>
        <p class="section-lead">
          The Coordinator tracks public wallet state and helps you build unsigned transactions you will sign on SeedMask. Private keys never enter the application.
        </p>
      </div>
      <div class="coord-stage">
        <CoordinatorMock />
      </div>
      <div class="pillars app-hero-pillars">
        <article class="pillar">
          <span class="pillar-index">01</span>
          <h3>Keys stay offline</h3>
          <p>Your seed never enters Coordinator. Signing happens only on SeedMask.</p>
        </article>
        <article class="pillar">
          <span class="pillar-index">02</span>
          <h3>Review before you sign</h3>
          <p>Check amount and destination on desktop, then confirm again on the device screen.</p>
        </article>
        <article class="pillar">
          <span class="pillar-index">03</span>
          <h3>Air-gapped end to end</h3>
          <p>
            Build an unsigned transaction on desktop, sign it on SeedMask, then bring the signed transaction back to broadcast — nothing spends without your on-device approval.
          </p>
        </article>
        <article class="pillar">
          <span class="pillar-index">04</span>
          <h3>No hot wallet</h3>
          <p>
            Coordinator is watch-only by design. There is no hot wallet inside the app, so a compromised desktop cannot silently move funds.
          </p>
        </article>
      </div>
      <div class="prose app-hero-prose">
        <h2>Air-gapped signing story</h2>
        <p>
          Prepare a transaction on your computer. Move the unsigned payload to your SeedMask device. Confirm amounts and destinations on the device screen. Bring the signature back and broadcast when you are ready.
        </p>
        <h2>Built for Bitcoin &amp; Kaspa</h2>
        <p>
          One clear desktop view for the chains SeedMask supports — balances, history, addresses, and coin (UTXO) lists aligned with how you actually custody funds. Light and dark themes ship with the app; the mock above shows Light mode.
        </p>
        <p>
          Coordinator can also watch wallets whose keys already live on a Ledger or OneKey — same rule as SeedMask: public state on the desktop, signing on the device.
        </p>
        <p class="home-backup-note">
          <strong>SeedMask is not affiliated with Ledger or OneKey.</strong>
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight" id="download">
    <div class="container">
      <h2 class="section-title">Get Coordinator v{downloads.version}</h2>
      <p class="section-lead tut-hero-lead">Watch-only desktop app for macOS, Windows, and Linux.</p>
      <p class="section-lead tut-hero-lead">
        Private keys never enter the Coordinator — signing stays on hardware wallet (cold storage).
      </p>
      <div class="download-grid">
        <a class="download-card" href={downloads.macArm} download>
          <div>
            <strong>macOS</strong>
            <span>Apple Silicon · .dmg</span>
          </div>
          <span class="download-cta">Download</span>
        </a>
        <div class="download-card is-soon" aria-disabled="true">
          <div>
            <strong>Windows</strong>
            <span>Coming soon</span>
          </div>
          <span class="download-cta muted">Soon</span>
        </div>
        <div class="download-card is-soon" aria-disabled="true">
          <div>
            <strong>Linux</strong>
            <span>Coming soon</span>
          </div>
          <span class="download-cta muted">Soon</span>
        </div>
      </div>
      <p class="download-note">
        Current build: macOS Apple Silicon (.dmg). Windows and Linux downloads will appear here when those packages are ready.
      </p>

      <aside class="macos-gatekeeper" aria-labelledby="macos-open-heading">
        <p class="eyebrow">macOS</p>
        <h3 id="macos-open-heading">If macOS blocks the app</h3>
        <div class="macos-gatekeeper-layout">
          <div class="macos-gatekeeper-copy">
            <p>
              Apple blocks apps that are not notarized yet. This build is an early SeedMask release and is <strong>not notarized</strong>.
            </p>
            <ol class="macos-gatekeeper-steps">
              <li>Move Coordinator into <strong>Applications</strong> and open it once (you will get a block).</li>
              <li>
                Open <strong>System Settings → Privacy &amp; Security</strong>, scroll to <strong>Security</strong>, then
                click <strong>Open Anyway</strong> next to SeedMask Coordinator.
              </li>
              <li>Confirm <strong>Open Anyway</strong> when macOS asks again.</li>
            </ol>
            <p class="macos-gatekeeper-why">
              <strong>Why?</strong> macOS only fully trusts apps Apple has notarized. We are shipping a public alpha before
              SeedMask Developer signing is ready. Coordinator is watch-only and never holds your seed — this warning is
              about Apple’s distribution rules, not a claim that the file is malware. A notarized SeedMask build will remove
              this step.
            </p>
          </div>
          <figure class="macos-gatekeeper-figure">
            <div class="macos-settings-card" role="img" aria-label="macOS Privacy and Security: SeedMask Coordinator was blocked, with Open Anyway highlighted">
              <div class="macos-settings-card-title">Security</div>
              <div class="macos-settings-row">
                <span>Allow applications from</span>
                <span class="macos-settings-select">App Store &amp; Known Developers</span>
              </div>
              <div class="macos-settings-block">
                <div class="macos-settings-block-main">
                  <p class="macos-settings-block-msg">
                    “SeedMask Coordinator” was blocked to protect your Mac.
                  </p>
                  <p class="macos-settings-block-note">
                    Apple could not verify “SeedMask Coordinator” is free of malware that may harm your Mac or
                    compromise your privacy.
                  </p>
                </div>
                <span class="macos-settings-open-anyway">Open Anyway</span>
              </div>
            </div>
            <figcaption>System Settings → Privacy &amp; Security → Open Anyway</figcaption>
          </figure>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <section class="magic-panel magic-nodes" id="own-nodes">
        <div class="magic-panel-copy">
          <p class="eyebrow">Infrastructure</p>
          <h2>Run your own nodes</h2>
          <p>
            Point Coordinator at Bitcoin Core or kaspad. Verify and broadcast without a third-party API — while signing still stays on SeedMask.
          </p>
          <p class="magic-note">Not affiliated with Bitcoin Core or kaspad.</p>
        </div>
        <div class="magic-nodes-visual" aria-hidden="true">
          <div class="magic-orbit magic-orbit-a"></div>
          <div class="magic-orbit magic-orbit-b"></div>
          <div class="magic-core">
            <img src="/branding/seedmask-mark.png" alt="" />
            <span>Coordinator</span>
          </div>
          <div class="magic-beam magic-beam-left"></div>
          <div class="magic-beam magic-beam-right"></div>
          <div class="magic-leaf magic-leaf-btc">
            <span class="magic-leaf-aura"></span>
            <span class="magic-leaf-spark spark-1"></span>
            <span class="magic-leaf-spark spark-2"></span>
            <span class="magic-leaf-spark spark-3"></span>
            <div class="magic-leaf-logo">
              <img src="/branding/bitcoin-btc-logo.png" alt="" />
            </div>
            <strong>Bitcoin Core</strong>
            <em>Your node · live</em>
          </div>
          <div class="magic-leaf magic-leaf-kas">
            <span class="magic-leaf-aura"></span>
            <span class="magic-leaf-spark spark-1"></span>
            <span class="magic-leaf-spark spark-2"></span>
            <span class="magic-leaf-spark spark-3"></span>
            <div class="magic-leaf-logo">
              <img src="/branding/kaspa-kas-logo.png" alt="" />
            </div>
            <strong>kaspad</strong>
            <em>Your node · live</em>
          </div>
        </div>
      </section>

      <section class="magic-panel magic-mobile" id="mobile">
        <div class="magic-mobile-glow" aria-hidden="true"></div>
        <div class="magic-panel-copy">
          <p class="eyebrow">Coming next</p>
          <h2>Mobile app</h2>
          <p>Android and iOS — watch-only. Keys stay on SeedMask.</p>
        </div>
        <div class="magic-phones" aria-hidden="true">
          <div class="device-android">
            <div class="device-android-cam"></div>
            <div class="device-android-screen">
              <div class="device-android-status">
                <i></i><i></i><i></i>
              </div>
              <img src="/branding/seedmask-mark.png" alt="" />
              <span>Android</span>
              <div class="device-android-nav">
                <b></b><b></b><b></b>
              </div>
            </div>
          </div>
          <div class="device-ios">
            <div class="device-ios-island"></div>
            <div class="device-ios-screen">
              <img src="/branding/seedmask-mark.png" alt="" />
              <span>iOS</span>
              <div class="device-ios-home"></div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <div class="cta-panel">
        <div>
          <h2>Hardware + Coordinator</h2>
          <p>The full SeedMask loop: cold keys on device, watch-only control on desktop.</p>
        </div>
        <ComingSoonButton href="/products/hardware" />
      </div>
    </div>
  </section>
</BaseLayout>
