---
import BaseLayout from '../layouts/BaseLayout.astro';
import DeviceAbstract from '../components/DeviceAbstract.astro';
import ComingSoonButton from '../components/ComingSoonButton.astro';
import CoordinatorMock from '../components/CoordinatorMock.astro';
---

<BaseLayout>
  <div class="home-alive">
    <section class="hero hero-premium">
      <div class="hero-atmosphere" aria-hidden="true"></div>
      <div class="hero-grid-lines" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="hero-eyebrow reveal">
            <span>Hardware wallet</span>
            <span class="hero-eyebrow-sep" aria-hidden="true"></span>
            <span>Bitcoin &amp; Kaspa only</span>
          </p>
          <h1 class="hero-brand reveal delay-1">Seed<span>Mask</span> Pro</h1>
          <p class="hero-headline reveal delay-2">Mask your seed. Sign offline.</p>
          <p class="hero-support reveal delay-2">
            Air-gapped hardware for Bitcoin and Kaspa. Keys stay on device. Confirm every send on the 4″ screen.
          </p>
          <div class="hero-actions reveal delay-3">
            <ComingSoonButton />
            <a class="btn btn-ghost hero-ghost" href="/features/device">Explore features</a>
          </div>
          <div class="hero-tech reveal delay-3">
            <div class="hero-tech-head">
              <p>Device profile</p>
              <span class="hero-tech-note">Upcoming retail device</span>
            </div>
            <dl class="hero-tech-grid">
              <div>
                <dt>Signing</dt>
                <dd>Air-gapped</dd>
              </div>
              <div>
                <dt>Display</dt>
                <dd>4″ touch</dd>
              </div>
              <div>
                <dt>Chains</dt>
                <dd>Bitcoin · Kaspa</dd>
              </div>
              <div>
                <dt>Also on device</dt>
                <dd>Passwords · 2FA · Notes</dd>
              </div>
              <div>
                <dt>Backup code</dt>
                <dd>Password-gated</dd>
              </div>
              <div>
                <dt>Seed</dt>
                <dd>On device only</dd>
              </div>
              <div>
                <dt>Firmware &amp; Hardware</dt>
                <dd>Open-source</dd>
              </div>
              <div>
                <dt>Security</dt>
                <dd>Anti-tamper · Secure element <span class="hero-tech-more"><a href="/about#physical-security">and more</a></span></dd>
              </div>
            </dl>
          </div>
        </div>

        <div class="hero-visual hero-atelier">
          <div class="atelier-stage">
            <DeviceAbstract caption={false} src="/illustrations/seedmask-device-hero.png" />
            <p class="atelier-mark">Offline signer - and beyond</p>
            <p class="atelier-note">Preview render — not the final look of the device</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section-tight trust-pillars-section home-pillars">
      <div class="container">
        <div class="pillars">
          <article class="pillar" data-rise>
            <span class="pillar-index">01</span>
            <h3>Air-gapped signing</h3>
            <p>Confirm every send on the 4″ screen — keys stay offline.</p>
          </article>
          <article class="pillar" data-rise>
            <span class="pillar-index">02</span>
            <h3>Watch-only app</h3>
            <p>Coordinator never holds your seed. Desktop stays clean.</p>
          </article>
          <article class="pillar" data-rise>
            <span class="pillar-index">03</span>
            <h3>
              <span class="pillar-chain-title">
                <img src="/branding/bitcoin-btc-logo.png" alt="" />
                <img src="/branding/kaspa-kas-logo.png" alt="" />
                <span>Bitcoin &amp; Kaspa</span>
              </span>
            </h3>
            <p>Focused support — Satoshi’s vision, and beyond.</p>
          </article>
          <article class="pillar" data-rise>
            <span class="pillar-index">04</span>
            <h3>Mask more than crypto</h3>
            <p>Passwords, 2FA, and notes — masked on device with your backup.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section home-backup">
      <div class="container home-backup-grid" data-rise>
        <div class="home-backup-copy">
          <p class="eyebrow">Backup code</p>
          <h2 class="section-title">Recovery that always resolves the same way</h2>
          <p class="section-lead">
            You keep a short backup code you can write down or print — and a password only you know.
          </p>
          <p class="home-backup-detail">
            On any SeedMask device, both together always derive the same seed. Alone, neither is enough: a found code
            is useless without your password, and the password alone cannot unlock recovery. No cloud backup, no
            guessing — deterministic recovery you can verify.
          </p>
          <p class="home-backup-note">
            <strong>A strong password is recommended</strong> — it is the only link that protects the backup code.
          </p>
        </div>
        <figure class="home-backup-figure">
          <div class="home-backup-diagram" aria-hidden="true">
            <div class="home-backup-unit">
              <p class="home-backup-kicker">Backup code</p>
              <div class="home-backup-cells">
                <span></span><span></span><span></span>
                <span></span><span></span><span></span>
              </div>
              <p class="home-backup-meta">Offline copy</p>
            </div>
            <span class="home-backup-op" aria-hidden="true">+</span>
            <div class="home-backup-unit">
              <p class="home-backup-kicker">Password</p>
              <div class="home-backup-dots">
                <i></i><i></i><i></i><i></i><i></i><i></i>
              </div>
              <p class="home-backup-meta">Yours alone</p>
            </div>
            <span class="home-backup-op home-backup-op-arrow" aria-hidden="true">→</span>
            <div class="home-backup-unit home-backup-unit-result">
              <p class="home-backup-kicker">Seed</p>
              <div class="home-backup-seed">
                <span></span><span></span><span></span>
              </div>
              <p class="home-backup-meta">Always the same</p>
            </div>
          </div>
          <figcaption class="home-backup-caption">
            Backup code + password → seed. Same inputs, same result — every time.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section home-coord">
      <div class="container">
        <div class="coord-intro" data-rise>
          <div>
            <p class="eyebrow">SeedMask Coordinator</p>
            <h2 class="section-title">Watch-only desktop control</h2>
            <p class="section-lead">
              Balances, addresses, and unsigned transactions on your machine. Move them to SeedMask to sign, then bring the signed transaction back — without exposing keys to the network.
            </p>
            <div class="hero-actions" style="margin-top: 28px">
              <a class="btn btn-ghost" href="/app">Explore the app</a>
            </div>
          </div>
        </div>
        <div class="coord-stage" data-rise>
          <CoordinatorMock />
        </div>
      </div>
    </section>

    <section class="section band home-cta">
      <div class="container">
        <div class="cta-panel cta-panel-home" data-rise>
          <div>
            <h2>Retail hardware isn’t available yet</h2>
            <p>Product updates from @Seedmask — this site is where we’ll announce when orders open.</p>
          </div>
          <div class="hero-actions">
            <a class="btn btn-primary" href="https://x.com/Seedmask" target="_blank" rel="noopener noreferrer">Follow on X</a>
            <a class="btn btn-ghost" href="/products/hardware">See the device</a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    const root = document.querySelector('.home-alive');
    if (root) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const nodes = root.querySelectorAll('[data-rise], [data-flow]');
      if (reduce) {
        nodes.forEach((el) => el.classList.add('is-in'));
      } else {
        root.querySelectorAll('[data-rise]').forEach((el) => {
          const siblings = el.parentElement
            ? [...el.parentElement.children].filter((c) => c.hasAttribute('data-rise'))
            : [];
          const index = Math.max(0, siblings.indexOf(el));
          el.style.setProperty('--rise-delay', `${index * 80}ms`);
        });
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -4% 0px' }
        );
        nodes.forEach((el) => io.observe(el));
        // Never leave sections invisible if the observer misses them
        window.setTimeout(() => {
          nodes.forEach((el) => el.classList.add('is-in'));
        }, 900);
      }
    }
  </script>


</BaseLayout>
