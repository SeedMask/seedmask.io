---
import BaseLayout from '../layouts/BaseLayout.astro';
import DeviceAbstract from '../components/DeviceAbstract.astro';
import ComingSoonButton from '../components/ComingSoonButton.astro';
import CoordinatorMock from '../components/CoordinatorMock.astro';
---

<BaseLayout>
  <div class="home-alive">
    <section class="hero hero-premium">
      <div class="hero-atmosphere" aria-hidden="true"></div>
      <div class="hero-grid-lines" aria-hidden="true"></div>
      <div class="container">
        <p class="hero-eyebrow reveal">
          <span>Hardware wallet</span>
          <span class="hero-eyebrow-sep" aria-hidden="true"></span>
          <span>Bitcoin &amp; Kaspa only</span>
        </p>
      </div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <h1 class="hero-brand reveal delay-1">Seed<span>Mask</span> Pro</h1>
          <p class="hero-headline reveal delay-2">Mask your seed. Sign offline.</p>
          <p class="hero-support reveal delay-2">
            Air-gapped hardware for Bitcoin and Kaspa. Keys stay on device. Confirm every send on the 3.5″ screen.
          </p>
          <div class="hero-actions reveal delay-3">
            <ComingSoonButton />
            <a class="btn btn-ghost hero-ghost" href="/features">Explore features</a>
          </div>
          <div class="hero-tech reveal delay-3">
            <p class="hero-tech-head">Device profile</p>
            <dl class="hero-tech-grid">
              <div>
                <dt>Signing</dt>
                <dd>Air-gapped</dd>
              </div>
              <div>
                <dt>Display</dt>
                <dd>3.5″ touch</dd>
              </div>
              <div>
                <dt>Chains</dt>
                <dd>Bitcoin · Kaspa</dd>
              </div>
              <div>
                <dt>Also on device</dt>
                <dd>Passwords · 2FA · Notes</dd>
              </div>
            </dl>
          </div>
        </div>

        <div class="hero-visual hero-atelier">
          <div class="atelier-stage">
            <DeviceAbstract caption={false} src="/illustrations/device-35-cutout.png" />
            <p class="atelier-mark">SeedMask Pro · offline signer</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section-tight trust-pillars-section home-pillars">
      <div class="container">
        <div class="pillars">
          <article class="pillar" data-rise>
            <span class="pillar-index">01</span>
            <h3>Air-gapped signing</h3>
            <p>Confirm every send on the 3.5″ screen — keys stay offline.</p>
          </article>
          <article class="pillar" data-rise>
            <span class="pillar-index">02</span>
            <h3>Watch-only app</h3>
            <p>Coordinator never holds your seed. Desktop stays clean.</p>
          </article>
          <article class="pillar" data-rise>
            <span class="pillar-index">03</span>
            <h3>
              <span class="pillar-chain-title">
                <img src="/branding/bitcoin-btc-logo.png" alt="" />
                <img src="/branding/kaspa-kas-logo.png" alt="" />
                <span>Bitcoin &amp; Kaspa</span>
              </span>
            </h3>
            <p>Focused support — Satoshi’s vision, and beyond.</p>
          </article>
          <article class="pillar" data-rise>
            <span class="pillar-index">04</span>
            <h3>Mask more than crypto</h3>
            <p>Passwords, 2FA, and notes — masked on device with your backup.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section band home-flow">
      <div class="container">
        <div class="home-flow-head" data-rise>
          <p class="eyebrow">How it works</p>
          <h2 class="section-title">Three steps. One air gap.</h2>
          <p class="section-lead">
            SeedMask separates watching from authorizing — so your everyday computer never holds the keys that move funds.
          </p>
        </div>
        <ol class="flow-steps" data-flow>
          <li data-rise>
            <div class="flow-visual" aria-hidden="true">
              <svg viewBox="0 0 160 100" fill="none">
                <rect x="18" y="14" width="88" height="62" rx="8" stroke="currentColor" stroke-width="1.6" opacity="0.35"/>
                <rect x="26" y="22" width="72" height="40" rx="4" fill="currentColor" opacity="0.06"/>
                <path d="M34 34h40M34 42h28M34 50h34" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity="0.45"/>
                <rect x="78" y="40" width="64" height="46" rx="8" fill="#fff" stroke="currentColor" stroke-width="1.6"/>
                <path d="M90 56h40M90 64h28" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
                <circle cx="126" cy="78" r="10" fill="var(--teal-soft)" stroke="var(--teal)" stroke-width="1.5"/>
                <path d="M122 78h8" stroke="var(--teal-deep)" stroke-width="1.7" stroke-linecap="round"/>
                <text x="28" y="88" fill="currentColor" font-size="8" font-family="Outfit, sans-serif" opacity="0.45">Coordinator</text>
              </svg>
            </div>
            <span class="flow-num">01</span>
            <h3>Build an unsigned transaction</h3>
            <p>Create Bitcoin or Kaspa transactions in Coordinator. Review amounts and destinations in a clear watch-only workspace.</p>
          </li>
          <li data-rise>
            <div class="flow-visual" aria-hidden="true">
              <svg viewBox="0 0 160 100" fill="none">
                <rect x="52" y="10" width="56" height="78" rx="10" stroke="currentColor" stroke-width="1.6"/>
                <rect x="60" y="22" width="40" height="48" rx="5" fill="var(--teal-soft)" stroke="var(--teal)" stroke-width="1.3"/>
                <path d="M70 40h20M70 48h14" stroke="var(--teal-deep)" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/>
                <circle cx="80" cy="78" r="3.5" fill="currentColor" opacity="0.25"/>
                <path d="M28 36c8-10 16-10 24 0" stroke="var(--teal)" stroke-width="1.5" stroke-linecap="round" opacity="0.55"/>
                <path d="M108 36c8-10 16-10 24 0" stroke="var(--teal)" stroke-width="1.5" stroke-linecap="round" opacity="0.55"/>
                <path d="M34 48h14M112 48h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.3" stroke-dasharray="3 3"/>
                <text x="58" y="98" fill="currentColor" font-size="8" font-family="Outfit, sans-serif" opacity="0.45">Air-gapped</text>
              </svg>
            </div>
            <span class="flow-num">02</span>
            <h3>Sign on SeedMask</h3>
            <p>Move the unsigned transaction to the device. Read every detail on the 3.5″ touchscreen before you approve.</p>
          </li>
          <li data-rise>
            <div class="flow-visual" aria-hidden="true">
              <svg viewBox="0 0 160 100" fill="none">
                <rect x="18" y="28" width="52" height="40" rx="8" stroke="currentColor" stroke-width="1.6" opacity="0.4"/>
                <path d="M28 42h28M28 50h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
                <path d="M78 48h18" stroke="var(--teal)" stroke-width="1.7" stroke-linecap="round"/>
                <path d="M90 42l8 6-8 6" stroke="var(--teal)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="126" cy="48" r="18" stroke="var(--teal)" stroke-width="1.5" fill="var(--teal-soft)"/>
                <circle cx="126" cy="48" r="10" stroke="var(--teal)" stroke-width="1.3" opacity="0.55"/>
                <circle cx="126" cy="48" r="3.5" fill="var(--teal-deep)"/>
                <path d="M118 30c10-8 18-8 28 0M114 24c14-10 24-10 36 0" stroke="var(--teal)" stroke-width="1.3" stroke-linecap="round" opacity="0.4"/>
                <text x="22" y="88" fill="currentColor" font-size="8" font-family="Outfit, sans-serif" opacity="0.45">Broadcast</text>
              </svg>
            </div>
            <span class="flow-num">03</span>
            <h3>Broadcast the signed transaction</h3>
            <p>Return the signed transaction to Coordinator and broadcast — only after you have authorized offline.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="section home-coord">
      <div class="container">
        <div class="coord-intro" data-rise>
          <div>
            <p class="eyebrow">SeedMask Coordinator</p>
            <h2 class="section-title">Watch-only desktop control</h2>
            <p class="section-lead">
              Balances, addresses, and unsigned transactions on your machine. Move them to SeedMask to sign, then bring the signed transaction back — without exposing keys to the network.
            </p>
            <div class="hero-actions" style="margin-top: 28px">
              <a class="btn btn-ghost" href="/app">Explore the app</a>
            </div>
          </div>
        </div>
        <div class="coord-stage" data-rise>
          <CoordinatorMock />
        </div>
      </div>
    </section>

    <section class="section band home-hardware">
      <div class="container split">
        <div class="hero-visual home-hardware-visual" data-rise>
          <div class="hero-glow"></div>
          <DeviceAbstract />
        </div>
        <div data-rise>
          <p class="eyebrow">Hardware</p>
          <h2 class="section-title">Air-gapped by design</h2>
          <p class="section-lead">
            SeedMask is a dedicated signing device for Bitcoin and Kaspa — and a place to mask passwords, 2FA, and notes behind your seed. No multi-chain sprawl. No soft wallet pretending to be cold storage.
          </p>
          <ul class="home-check">
            <li>3.5″ confirmation screen</li>
            <li>Password manager, notes &amp; 2FA on device</li>
            <li>Passphrase, BIP85 &amp; temporary wallets</li>
          </ul>
          <div class="hero-actions" style="margin-top: 28px">
            <ComingSoonButton href="/products" />
            <a class="btn btn-ghost" href="/features">Explore features</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section band home-cta">
      <div class="container">
        <div class="cta-panel cta-panel-home" data-rise>
          <div>
            <h2>Hardware is almost here</h2>
            <p>Follow @Seedmask for updates — Coming soon is the door for the device.</p>
          </div>
          <div class="hero-actions">
            <ComingSoonButton href="/products" />
            <a class="btn btn-ghost" href="https://x.com/Seedmask" target="_blank" rel="noopener noreferrer">Follow on X</a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    const root = document.querySelector('.home-alive');
    if (root) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const nodes = root.querySelectorAll('[data-rise], [data-flow]');
      if (reduce) {
        nodes.forEach((el) => el.classList.add('is-in'));
      } else {
        root.querySelectorAll('[data-rise]').forEach((el) => {
          const siblings = el.parentElement
            ? [...el.parentElement.children].filter((c) => c.hasAttribute('data-rise'))
            : [];
          const index = Math.max(0, siblings.indexOf(el));
          el.style.setProperty('--rise-delay', `${index * 80}ms`);
        });
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            });
          },
          { threshold: 0.16, rootMargin: '0px 0px -8% 0px' }
        );
        nodes.forEach((el) => io.observe(el));
      }
    }
  </script>


</BaseLayout>
