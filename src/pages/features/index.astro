---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Features — SeedMask"
  description="Choose SeedMask Features on the device, or flash and verify preview firmware from the browser."
>
  <section class="page-hero page-hero-learn">
    <div class="container">
      <p class="eyebrow">Features</p>
      <h1>What do you need?</h1>
      <p>Flash preview firmware, or explore what SeedMask does on the device beyond signing.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container features-hub">
      <a class="learn-card" href="/features/firmware">
        <img class="learn-card-cover" src="/illustrations/features-firmware-10.png" alt="" />
        <span class="learn-card-meta">01 · Firmware</span>
        <h3>Firmware</h3>
        <p>Flash the official preview image from the browser, or download files and verify SHA-256 checksums.</p>
        <span class="learn-card-cta">Open firmware →</span>
      </a>
      <a class="learn-card" href="/features/device">
        <img class="learn-card-cover" src="/illustrations/features-device.png" alt="" />
        <span class="learn-card-meta">02 · Device</span>
        <h3>SeedMask Features</h3>
        <p>Password manager, notes, 2FA, air gap, backup, passphrase, BIP85, duress, and more on the 4″ device.</p>
        <span class="learn-card-cta">Explore features →</span>
      </a>
    </div>
  </section>
</BaseLayout>
