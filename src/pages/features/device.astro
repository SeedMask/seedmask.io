---
import BaseLayout from '../../layouts/BaseLayout.astro';

const features = [
  {
    id: 'password-manager',
    index: '01',
    title: 'Password manager',
    lead: 'Create, store, and send credentials on SeedMask — secrets stay on the device until you approve reveal on the touchscreen.',
    graphic: 'passwords',
    body: [
      'A password manager on a phone or laptop is convenient — and exposed to the same malware and cloud sync risks as everything else on that machine. SeedMask keeps credentials offline: generate or store them on the device, then reveal or send only after you confirm on the screen.',
      'Use it for accounts that matter: exchange logins, email, and any service where a leak would put funds or identity at risk. For stricter generation rules, see Advanced options — advanced password creation.',
    ],
    advice: [
      'Prefer device-generated passwords over inventing your own.',
      'Confirm the destination on-screen before any “send” or reveal.',
      'Never photograph passwords or paste them into chat apps.',
      'Keep a clear naming scheme so you do not mix similar accounts.',
    ],
    tip: 'Treat SeedMask passwords like seed material: offline by default, human confirmation before anything leaves the device.',
  },
  {
    id: 'notes',
    index: '02',
    title: 'Secure notes',
    lead: 'Keep short private notes offline — secrets, labels, or instructions you do not want in a phone notes app.',
    graphic: 'notes',
    body: [
      'Phone notes sync, get screenshotted, and sit next to the same apps that browse the web. SeedMask notes are meant for small, high-sensitivity text that should live with your cold vault — not in iCloud or Google.',
      'Good fits: wallet labels, recovery passphrases, backup codes, safe-deposit reminders, or setup steps you might need years later. Bad fits: long documents, anything you need to edit every day, or the same secret stored in cleartext elsewhere too.',
    ],
    advice: [
      'Keep notes short and deliberate — this is a vault, not a journal... for now.',
      'Secure notes can hold real secrets — passphrases, backup codes, and other sensitive text that should stay on the device.',
      'Do not keep a second copy in a synced notes app or a screenshot; SeedMask should be the offline source.',
      'Review notes occasionally and delete what you no longer need.',
    ],
    tip: 'If a note would be catastrophic if leaked, it belongs on SeedMask — and nowhere that auto-syncs.',
  },
  {
    id: '2fa',
    index: '03',
    title: '2FA authenticator',
    lead: 'Store TOTP secrets on SeedMask and show one-time codes on the 4″ screen — air-gapped from the browser.',
    graphic: '2fa',
    body: [
      'Authenticator apps on phones are better than SMS — but the phone is still online, lost, reset, and backed up in ways you may not control. SeedMask can hold TOTP secrets and display codes only when you unlock and open them on the device.',
      'That pairs well with exchange and email accounts that already demand 2FA. The code lives behind your PIN and physical device, not in a notification shade on a compromised handset.',
    ],
    advice: [
      'Add 2FA for exchanges, email, and password managers first.',
      'Save issuer backup codes offline when the service offers them.',
      'Confirm you can still log in before you remove an old authenticator.',
      'Do not leave the TOTP secret in email or screenshots after setup.',
    ],
    tip: '2FA on SeedMask raises the bar: stealing a password alone is no longer enough if the second factor never leaves the vault.',
  },
  {
    id: 'passphrase',
    index: '04',
    title: 'Passphrase',
    lead: 'Add a BIP39 passphrase for layered wallets. Enter it only on SeedMask — it never leaves the device.',
    graphic: 'pass',
    body: [
      'A passphrase (sometimes called a “25th word”) combines with your seed to derive a different wallet. The same seed with no passphrase is not the same vault as the same seed with a passphrase.',
      'People use this for stronger isolation or plausible deniability. Both uses fail if you forget the passphrase, mistype it into the wrong place, or store it less carefully than the seed itself.',
    ],
    advice: [
      'Only enable a passphrase if you will back it up as carefully as the seed.',
      'Never store the seed and passphrase together in plain text — keep them in separate places.',
      'A passphrase opens a hidden wallet — take the same care with it as your seed.',
      'Test recovery with a tiny amount before you rely on a passphrase wallet.',
      'Remember: lose the passphrase and that wallet is gone, even with the seed.',
    ],
    tip: 'Passphrase is power with sharp edges. If you are unsure, use seed-only until your backup discipline is rock solid.',
  },
  {
    id: 'bip85',
    index: '05',
    title: 'BIP85 child seeds',
    lead: 'Derive child mnemonics from your master seed for separate wallets — the parent stays on SeedMask.',
    graphic: 'bip85',
    body: [
      'BIP85 lets you generate child seeds from a master seed in a deterministic way. That can help you spin up separate wallets for different purposes without inventing unrelated backups from scratch.',
      'The master remains the root of recovery for those children. That is convenient — and it means the master backup is even more important. Compromising the master compromises the tree.',
    ],
    advice: [
      'Keep a clear map of which child index is for which purpose.',
      'Do not treat child seeds as “disposable” if they will hold real funds.',
      'Protect the master seed as the recovery root for the whole family.',
      'Prefer documented indexes over improvising new ones under stress.',
    ],
    tip: 'BIP85 is organization for advanced users. Master-seed discipline still rules everything downstream.',
  },
  {
    id: 'stateless',
    index: '06',
    title: 'Temporary / Stateless',
    lead: 'Temporary and Stateless are two different modes. Temporary: a session seed in RAM while your master stays saved. Stateless: no permanent seed on the device — enter a phrase fresh every boot.',
    graphic: 'temp',
    body: [
      'Temporary seed: load a secondary recovery phrase into device RAM for a single session. Your permanent master seed stays saved on SeedMask. When you are done, remove the temporary seed — it leaves; the master is untouched.',
      'Stateless: the device never stores a permanent seed at all. Every time it boots, you input a phrase fresh for that session. Nothing lasting stays on the hardware when you power down or wipe.',
      'Use temporary when you want a session wallet without disturbing what is already stored. Use stateless when you want the device itself to hold no lasting custody state — travel, shared handling, or an empty-vault habit. Funds follow your offline backup, not device memory.',
    ],
    advice: [
      'Temporary: master stays saved; session seed lives in RAM until you remove it.',
      'Stateless: no permanent seed on device — enter a phrase fresh each boot.',
      'Do not confuse the two: removing a temporary seed does not wipe your master.',
      'Still confirm amount and destination on the screen every time.',
    ],
    tip: 'Temporary = session on top of a saved master. Stateless = no permanent seed stored at all.',
  },
  {
    id: 'air-gapped',
    index: '07',
    title: 'Air-gapped · QR & MicroSD',
    lead: 'Move unsigned and signed data without putting SeedMask on your everyday network — via QR codes or a MicroSD card.',
    graphic: 'airgap',
    body: [
      'Air-gapped signing means the keys stay offline while you still complete real transactions. Coordinator prepares; SeedMask authorizes; the result goes back out for broadcast.',
      'QR is fast for many flows: show or scan what needs to cross the gap. MicroSD helps when payloads are larger or you prefer a physical handoff. Either way, the point is the same — the signing brain does not need Wi‑Fi sitting next to your browser.',
    ],
    advice: [
      'Always read amount and destination on the SeedMask screen before approving.',
      'Prefer a known-good MicroSD reserved for wallet work when you use cards.',
      'Do not photograph seed words “to make QR easier later.”',
      'If a transfer looks wrong on-device, reject it — never approve from habit.',
    ],
    tip: 'QR and MicroSD are transport. Confirmation on the screen is still the security boundary.',
  },
  {
    id: 'backup-code',
    index: '08',
    title: 'Backup code',
    lead: 'A compact restore path for your seed — built for easier recovery when you need the vault back on a wiped or new device.',
    graphic: 'backup',
    body: [
      'Writing twenty-four words carefully is the classic backup. A backup code is meant to make restoration less painful when you must bring a wiped SeedMask — or a replacement unit — back to a working signer.',
      'The code alone is not enough: restore always needs your password too. A strong password is what protects a found code. Still keep the code offline and private — verified copy, not cloud notes or screenshots.',
    ],
    advice: [
      'Create and verify the backup code before you rely on a wipe-and-restore habit.',
      'Use a strong password — it is the gate that protects the code.',
      'Store the code offline — never in cloud notes, email, or screenshots.',
      'Test restore once with funds you can afford to practice on.',
      'If you also use a passphrase, back that up with equal care.',
    ],
    tip: 'The backup code is portable; the password is the gate. Easier restore is not an excuse to be careless with either.',
  },
  {
    id: 'dice-roll',
    index: '09',
    title: 'Dice roll',
    lead: 'Build seed entropy from physical dice rolls on the device — instead of taking the first hardware-random suggestion.',
    graphic: 'dice',
    body: [
      'When you create a wallet, entropy is everything. SeedMask can use hardware randomness, let you regenerate until you are satisfied, or collect dice rolls on the touchscreen.',
      'Dice roll is for people who want entropy to come from a physical process they control. You roll on-device, the firmware tracks enough rolls for a 12- or 24-word seed, then continues into the normal create flow.',
    ],
    advice: [
      'Use fair dice and a clean surface — no loaded dice, no shortcuts.',
      'Follow the on-screen roll count for your word length (often ~50 rolls for 12 words, ~100 for 24).',
      'Write the resulting seed offline immediately after creation — same discipline as any other path.',
      'Dice roll is optional. If you restore an existing seed, you are trusting whatever created it originally.',
    ],
    tip: 'Dice roll does not replace backup discipline. It replaces “trust the first random suggestion” with rolls you performed yourself.',
  },
  {
    id: 'vault-backup',
    index: '10',
    title: 'Vault backup',
    lead: 'Encrypted Vault QR from Seed Settings — restore the seed plus passwords, notes, and 2FA. Denser than a backup code; often several frames.',
    graphic: 'vault',
    body: [
      'Seed Settings has a Vault QR: the encrypted vault payload. Scan it back onto a wiped or new SeedMask and you restore the seed and what lives in the vault — password manager, notes, and 2FA.',
      'It is not the backup-code QR, which is seed-only (code + password). It is not View Seed’s QR, which is the words in the clear. Vault QR is a different, denser payload and often several frames.',
      'Restore still needs your vault password. Keep the frames offline — the same discipline as a backup code, because this one brings the whole vault back.',
    ],
    advice: [
      'Export Vault QR after the vault is set up. Verify restore before you rely on wipe.',
      'The vault password is the gate. A found set of frames without it should stay locked.',
      'Do not save the frames in cloud photos, chat, or email.',
      'Know which QR you scanned: backup code = seed only; Vault QR = seed + vault; View Seed = unprotected words.',
    ],
    tip: 'Vault QR brings the wallet and the vault back. Backup code brings the seed. View Seed QR is the words themselves.',
  },
  {
    id: 'view-seed-qr',
    index: '11',
    title: 'View Seed QR',
    lead: 'Export the mnemonic as a QR in three formats — Compact SeedQR, SeedQR, or plain text. Same seed, different encoding; none are encrypted.',
    graphic: 'view-seed-qr',
    body: [
      'On View Seed, the QR icon opens Export as QR. You pick how the words are encoded — not whether to hide them. Every option puts the full seed in the QR payload.',
      'That is different from the backup code (seed wrapped in a password) and from Vault QR (encrypted vault). View Seed QR is for a controlled, offline moment: show the code to another air-gapped device or wallet that expects SeedQR or a readable mnemonic.',
      'SeedMask restore scans Compact SeedQR and SeedQR via Restore → Seed → SeedQR. Plain text is for tools that decode the QR to space-separated English words.',
      'Note: All three formats are equally exposed — no encryption, no password. Compact, SeedQR, and plain text are the same risk as writing your words in the clear: anyone who captures the QR has your seed.',
    ],
    sections: [
      {
        title: 'Compact SeedQR',
        points: [
          'Smallest on screen - easiest to draw and scan.',
          'Works for moving the seed to another device that accepts compact SeedQR.',
        ],
      },
      {
        title: 'SeedQR',
        points: [
          'The default “SeedQR” many air-gapped wallets mean when they do not say compact.',
          'Numeric payload only — words stay hidden until the other device decodes them.',
        ],
      },
      {
        title: 'Plain text',
        points: [
          'Usually for online wallets and apps that import a mnemonic from QR as readable words.',
        ],
      },
    ],
    advice: [
      'Treat any export like a photograph of your seed — shoulder surfers, reflections, and saved screenshots count.',
      'Pick the format the other device documents: Compact and SeedQR for SeedQR restore; plain text for mnemonic-string import.',
      'Never upload QR photos to cloud, chat, or email.',
      'If you only need a password-protected backup, use the backup code — not View Seed QR.',
    ],
    tip: 'Compact to draw and scan, SeedQR for most air-gapped wallets, plain text when an online app wants the words themselves.',
  },
  {
    id: 'advanced',
    index: '12',
    title: 'Advanced options',
    lead: 'Deeper controls: advanced password creation, passphrase & BIP85 combinations, duress unlock paths, and attempt limits.',
    graphic: 'advanced',
    body: [
      'Advanced options are for people who already understand seed, PIN, and backup basics. They add power — and more ways to confuse yourself if you skip documentation and practice.',
    ],
    sections: [
      {
        title: 'Advanced password creation',
        body: 'Inside the password manager, advanced creation lets you set stricter generation rules — length, character sets, and patterns that match what a site will accept — while still keeping the secret on SeedMask until you approve reveal or send.',
        points: [
          'Generate on-device; do not invent “clever” passwords by hand.',
          'Match site rules without weakening length when you can avoid it.',
        ],
      },
      {
        title: 'Passphrase + BIP85 ≠ BIP85 temporary + passphrase',
        body: 'These are different setups with different recovery stories. Do not mix them up under stress.',
        points: [
          'Passphrase on your master seed derives a different wallet from that same mnemonic. Recovery = master seed words + that passphrase.',
          'BIP85 creates a child mnemonic from the master. That child can be used on its own (including as a temporary / wiped session).',
          'A BIP85 child used as a temporary wallet, then unlocked with a passphrase on that child, is not the same wallet as “master seed + passphrase,” and not the same as “master + BIP85 index” without the child’s passphrase.',
          'Write down which path you used: master+passphrase, BIP85 index, and whether a passphrase applies to the child. Wrong combination = empty wallet.',
        ],
      },
      {
        title: 'Duress mode',
        body: 'A duress PIN or password opens an alternate path when you are forced to unlock. SeedMask can present different duress types so the device does not hand over your real vault.',
        points: [
          'No-crypto — unlock looks normal but crypto signing / vault access is not your real wallet path.',
          'Games — the device opens into a benign diversion instead of custody tools.',
          'Decoy — unlock opens a real-looking wallet that is not your main one. SeedMask derives it from your master seed with BIP85 at a fixed child index (1001 if your master is 24 words, 2001 if it is 12 words). Same master + same index always rebuilds the same decoy; your primary wallet stays separate.',
          'Rehearse your duress choice. Under pressure you will use whatever you practiced — or freeze.',
        ],
      },
      {
        title: 'Attempt limit',
        body: 'Control what a thief sees on the lock screen while they guess, and what the device does when guesses run out.',
        points: [
          'Show or hide remaining attempts on the locked screen.',
          'Wipe silently when the limit is hit — so the hardware empties without a dramatic countdown theater.',
          'Silent wipe only helps if your backup code / seed backup is intact and reachable by you alone.',
        ],
      },
    ],
    advice: [
      'Turn on advanced options only after seed backup and restore are proven.',
      'Document passphrase vs BIP85 vs duress choices offline — briefly, privately.',
      'Practice duress unlock once so muscle memory matches your plan.',
      'Silent wipe without a tested backup is a self-destruct button.',
    ],
    tip: 'Advanced features multiply outcomes. Clarity on paper beats cleverness in your head.',
  },
];
---

<BaseLayout
  title="SeedMask Features — password manager, notes, 2FA & more"
  description="Explore SeedMask features: air-gapped QR & MicroSD, backup code, vault backup, View Seed QR formats, password manager, notes, 2FA, passphrase, BIP85, dice roll, stateless mode, duress, and advanced options."
>
  <section class="page-hero page-hero-learn">
    <div class="container">
      <p class="eyebrow">Features · Device</p>
      <h1>SeedMask Features</h1>
      <p>
        Beyond signing Bitcoin and Kaspa — air-gapped transport, backup, vault tools, and advanced controls on the 4″ device.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container feature-explorer" data-feature-explorer>
      <p class="feature-explorer-hint">Select a feature for the full walkthrough.</p>
      <div class="feature-mosaic">
        {
          features.map((feature) => (
            <article
              class="feature-tile"
              id={feature.id}
              data-feature-tile={feature.id}
            >
              <button
                type="button"
                class="feature-tile-trigger"
                data-feature-trigger={feature.id}
                aria-expanded="false"
                aria-controls={`feature-panel-${feature.id}`}
              >
                <div class={`feature-graphic graphic-${feature.graphic}`} aria-hidden="true">
                  {feature.graphic === 'passwords' && (
                    <div class="passwords-card">
                      <div class="passwords-visual" aria-hidden="true">
                        <div class="passwords-flow">
                          <span class="passwords-flow-step is-done">
                            <svg viewBox="0 0 16 16" width="10" height="10" fill="none" aria-hidden="true">
                              <path d="M8 2.5v4.2l2.2 1.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                              <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.4" />
                            </svg>
                            Create
                          </span>
                          <i class="passwords-flow-line"></i>
                          <span class="passwords-flow-step is-done">
                            <svg viewBox="0 0 16 16" width="10" height="10" fill="none" aria-hidden="true">
                              <rect x="3.5" y="7" width="9" height="6.5" rx="1.2" stroke="currentColor" stroke-width="1.4" />
                              <path d="M5.5 7V5.2a2.5 2.5 0 0 1 5 0V7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                            </svg>
                            Store
                          </span>
                          <i class="passwords-flow-line"></i>
                          <span class="passwords-flow-step is-active">
                            <svg viewBox="0 0 16 16" width="10" height="10" fill="none" aria-hidden="true">
                              <path d="M3.5 8.2 6.4 11.1 12.5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Send
                          </span>
                        </div>
                        <article class="passwords-credential">
                          <header class="passwords-credential-head">
                            <span class="passwords-site-icon" aria-hidden="true">
                              <svg viewBox="0 0 16 16" width="13" height="13" fill="none">
                                <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.4" />
                                <path d="M2.5 8h11M8 2.5a10 10 0 0 1 0 11M8 2.5a10 10 0 0 0 0 11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                              </svg>
                            </span>
                            <div class="passwords-credential-meta">
                              <span class="passwords-credential-label">Exchange login</span>
                              <strong>user@email.com</strong>
                            </div>
                          </header>
                          <div class="passwords-field">
                            <span class="passwords-mask">••••••••••••</span>
                            <span class="passwords-reveal">Reveal</span>
                          </div>
                          <footer class="passwords-foot">
                            <span>On device</span>
                            <span>Confirm to send</span>
                          </footer>
                        </article>
                      </div>
                    </div>
                  )}
                  {feature.graphic === 'notes' && (
                    <div class="notes-card">
                      <div class="notes-stack" aria-hidden="true">
                        <span class="notes-stack-layer notes-stack-layer-3"></span>
                        <span class="notes-stack-layer notes-stack-layer-2"></span>
                        <article class="notes-stack-front">
                          <header class="notes-stack-head">
                            <span class="notes-stack-lock">
                              <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
                                <rect x="3.5" y="7" width="9" height="6.5" rx="1.2" stroke="currentColor" stroke-width="1.4" />
                                <path d="M5.5 7V5.2a2.5 2.5 0 0 1 5 0V7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                              </svg>
                            </span>
                            <div class="notes-stack-title">
                              <strong>Secure note</strong>
                              <span>Private · on vault</span>
                            </div>
                          </header>
                          <ul class="notes-stack-list">
                            <li>Wallet label · A</li>
                            <li>Deposit box #12</li>
                            <li class="notes-stack-muted">Private reminder</li>
                          </ul>
                          <footer class="notes-stack-foot">
                            <span>No cloud sync</span>
                            <span>Offline</span>
                          </footer>
                        </article>
                      </div>
                    </div>
                  )}
                  {feature.graphic === '2fa' && (
                    <div class="twofa-card">
                      <div class="twofa-device" aria-hidden="true">
                        <span class="twofa-speaker"></span>
                        <span class="twofa-screen">
                          <span class="twofa-kicker">TOTP</span>
                          <div class="twofa-code">
                            <span>4</span><span>8</span><span>2</span>
                            <span>9</span><span>1</span><span>3</span>
                          </div>
                          <div class="twofa-timer">
                            <span class="twofa-timer-fill"></span>
                          </div>
                          <div class="twofa-meta">
                            <span class="twofa-issuer">Exchange</span>
                            <span class="twofa-countdown">30s</span>
                          </div>
                        </span>
                        <span class="twofa-home-dot"></span>
                      </div>
                    </div>
                  )}
                  {feature.graphic === 'pass' && (
                    <div class="passphrase-card">
                      <div class="passphrase-visual" aria-hidden="true">
                        <div class="passphrase-diagram">
                          <div class="passphrase-sources">
                            <article class="passphrase-source passphrase-source-seed">
                              <p class="passphrase-source-label">Seed</p>
                              <div class="passphrase-seed-grid">
                                <span>word</span><span>list</span><span>base</span>
                                <span>core</span><span>safe</span><span>key</span>
                              </div>
                            </article>
                            <span class="passphrase-plus" aria-hidden="true">+</span>
                            <article class="passphrase-source passphrase-source-pass">
                              <p class="passphrase-source-label">Passphrase</p>
                              <div class="passphrase-pass-input">
                                <span class="passphrase-pass-dots">••••••••</span>
                              </div>
                            </article>
                          </div>
                          <svg class="passphrase-merge" viewBox="0 0 200 24" preserveAspectRatio="none" aria-hidden="true">
                            <path d="M42 0 V8 M158 0 V8 M42 8 H100 M158 8 H100 M100 8 V24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                          <article class="passphrase-vault">
                            <span class="passphrase-vault-glow" aria-hidden="true"></span>
                            <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
                              <rect x="3.5" y="7" width="9" height="6.5" rx="1.2" stroke="currentColor" stroke-width="1.4" />
                              <path d="M5.5 7V5.2a2.5 2.5 0 0 1 5 0V7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                            </svg>
                            <div class="passphrase-vault-copy">
                              <strong>Hidden wallet</strong>
                              <span>Separate derivation</span>
                            </div>
                          </article>
                        </div>
                      </div>
                    </div>
                  )}
                  {feature.graphic === 'bip85' && (
                    <div class="bip85-card">
                      <div class="bip85-visual" aria-hidden="true">
                        <div class="bip85-diagram">
                          <div class="bip85-master">
                            <span class="bip85-master-badge">BIP85</span>
                            <strong>Master seed</strong>
                          </div>
                          <svg class="bip85-connectors" viewBox="0 0 160 26" preserveAspectRatio="none" aria-hidden="true">
                            <path d="M80 0 V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            <path d="M22 9 H138" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            <path d="M22 9 V26" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            <path d="M80 9 V26" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            <path d="M138 9 V26" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                          </svg>
                          <div class="bip85-children">
                            <span class="bip85-child">
                              <em>0</em>
                              Child
                            </span>
                            <span class="bip85-child is-active">
                              <em>1</em>
                              Child
                            </span>
                            <span class="bip85-child">
                              <em>2</em>
                              Child
                            </span>
                          </div>
                        </div>
                      </div>
                    </div>
                  )}
                  {feature.graphic === 'temp' && (
                    <div class="stateless-card">
                      <div class="stateless-visual" aria-hidden="true">
                        <div class="stateless-flow">
                          <article class="stateless-unit">
                            <div class="stateless-device">
                              <span class="stateless-screen">
                                <span class="stateless-seed-grid">
                                  <i></i><i></i><i></i><i></i>
                                </span>
                              </span>
