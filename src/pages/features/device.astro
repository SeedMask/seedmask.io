                                <rect x="15" y="15" width="14" height="2" rx="1" fill="#9aa8b4" opacity="0.85" />
                                <rect x="15" y="19" width="11" height="2" rx="1" fill="#9aa8b4" opacity="0.85" />
                                <rect x="15" y="23" width="12" height="2" rx="1" fill="#9aa8b4" opacity="0.85" />
                              </svg>
                            </div>
                            <span>Plain text</span>
                          </article>
                        </div>
                      </div>
                    </div>
                  )}
                  {feature.graphic === 'vault' && (
                    <div class="vault-backup-card">
                      <div class="vault-backup-visual" aria-hidden="true">
                        <div class="vault-backup-stack">
                          <span class="vault-backup-sheet vault-backup-sheet-3"></span>
                          <span class="vault-backup-sheet vault-backup-sheet-2"></span>
                          <article class="vault-backup-frame">
                            <header class="vault-backup-head">
                              <span class="vault-backup-lock">
                                <svg viewBox="0 0 16 16" width="13" height="13" fill="none">
                                  <rect x="3.5" y="7" width="9" height="6.5" rx="1.2" stroke="currentColor" stroke-width="1.4" />
                                  <path d="M5.5 7V5.2a2.5 2.5 0 0 1 5 0V7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                                </svg>
                              </span>
                              <div>
                                <strong>Vault QR</strong>
                                <span>Encrypted · multi-frame</span>
                              </div>
                            </header>
                            <div class="vault-backup-qr">
                              <svg viewBox="0 0 40 40" fill="none">
                                <rect width="40" height="40" fill="#fff" rx="3" />
                                <rect x="3" y="3" width="10" height="10" fill="#1a2430" />
                                <rect x="5" y="5" width="6" height="6" fill="#fff" />
                                <rect x="7" y="7" width="2" height="2" fill="#1a2430" />
                                <rect x="27" y="3" width="10" height="10" fill="#1a2430" />
                                <rect x="29" y="5" width="6" height="6" fill="#fff" />
                                <rect x="31" y="7" width="2" height="2" fill="#1a2430" />
                                <rect x="3" y="27" width="10" height="10" fill="#1a2430" />
                                <rect x="5" y="29" width="6" height="6" fill="#fff" />
                                <rect x="7" y="31" width="2" height="2" fill="#1a2430" />
                                <rect x="16" y="3" width="2" height="2" fill="#1a2430" />
                                <rect x="20" y="7" width="2" height="2" fill="#1a2430" />
                                <rect x="18" y="11" width="4" height="2" fill="#1a2430" />
                                <rect x="15" y="16" width="2" height="2" fill="#1a2430" />
                                <rect x="19" y="18" width="4" height="4" fill="#1a2430" />
                                <rect x="25" y="16" width="2" height="2" fill="#1a2430" />
                                <rect x="33" y="18" width="2" height="2" fill="#1a2430" />
                                <rect x="16" y="24" width="2" height="2" fill="#1a2430" />
                                <rect x="22" y="26" width="2" height="2" fill="#1a2430" />
                                <rect x="28" y="28" width="2" height="2" fill="#1a2430" />
                                <rect x="20" y="32" width="2" height="2" fill="#1a2430" />
                                <rect x="34" y="32" width="2" height="2" fill="#1a2430" />
                              </svg>
                            </div>
                            <footer class="vault-backup-foot">
                              <span>Frame 2 / 5</span>
                              <span>Seed + vault</span>
                            </footer>
                          </article>
                        </div>
                      </div>
                    </div>
                  )}
                </div>
                <span class="pillar-index">{feature.index}</span>
                <h2>{feature.title}</h2>
                <p>{feature.lead}</p>
                <span class="feature-tile-more" aria-hidden="true">
                  <span class="feature-tile-more-open">Read more</span>
                  <span class="feature-tile-more-close">Close</span>
                </span>
              </button>

              <div
                class="feature-tile-panel"
                id={`feature-panel-${feature.id}`}
                data-feature-panel={feature.id}
                hidden
              >
                {feature.body.map((p) => <p class="feature-panel-copy">{p}</p>)}
                {feature.sections && (
                  <div class="feature-sections">
                    {feature.sections.map((section) => (
                      <section class="feature-section">
                        <h3>{section.title}</h3>
                        {section.body && <p>{section.body}</p>}
                        {section.points && (
                          <ul>
                            {section.points.map((point) => (
                              <li>{point}</li>
                            ))}
                          </ul>
                        )}
                      </section>
                    ))}
                  </div>
                )}
                <div class="feature-advice-block">
                  <p class="feature-advice-label">Practical advice</p>
                  <ol class="feature-advice">
                    {feature.advice.map((item, ai) => (
                      <li>
                        <span class="feature-advice-num" aria-hidden="true">{String(ai + 1).padStart(2, '0')}</span>
                        <span class="feature-advice-text">{item}</span>
                      </li>
                    ))}
                  </ol>
                </div>
                <p class="feature-tip">
                  <span class="feature-tip-label">Keep in mind</span>
                  {feature.tip}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <div class="cta-panel">
        <div>
          <h2>Looking for firmware?</h2>
          <p>Flash and verify SeedMask preview firmware from your browser.</p>
        </div>
        <a class="btn btn-ghost" href="/features/firmware">Firmware →</a>
      </div>
      <p style="margin-top: 24px">
        <a class="btn btn-ghost" href="/features">← Features</a>
      </p>
    </div>
  </section>

  <script>
    const root = document.querySelector('[data-feature-explorer]');
    if (root) {
      const tiles = [...root.querySelectorAll('[data-feature-tile]')];

      const headerOffset = () => {
        const raw = getComputedStyle(document.documentElement)
          .getPropertyValue('--header-h')
          .trim();
        const parsed = Number.parseFloat(raw);
        return (Number.isFinite(parsed) ? parsed : 72) + 24;
      };

      const scrollToTile = (tile) => {
        if (!tile) return;
        const top = Math.max(
          0,
          window.scrollY + tile.getBoundingClientRect().top - headerOffset(),
        );
        window.scrollTo({ top, behavior: 'smooth' });
      };

      const open = (id, { scroll = false } = {}) => {
        tiles.forEach((tile) => {
          const on = tile.getAttribute('data-feature-tile') === id;
          const trigger = tile.querySelector('[data-feature-trigger]');
          const panel = tile.querySelector('[data-feature-panel]');
          tile.classList.toggle('is-open', on);
          trigger?.setAttribute('aria-expanded', on ? 'true' : 'false');
          if (panel) panel.hidden = !on;
        });
        root.classList.add('has-open-feature');
        history.replaceState(null, '', `#${id}`);
        if (scroll) {
          const tile = root.querySelector(`[data-feature-tile="${id}"]`);
          // Wait for open layout (full-width reflow + panel) before scrolling.
          requestAnimationFrame(() => {
            requestAnimationFrame(() => scrollToTile(tile));
          });
        }
      };

      const closeAll = () => {
        const openTile = tiles.find((tile) => tile.classList.contains('is-open'));
        const anchorTop = openTile?.getBoundingClientRect().top ?? null;

        tiles.forEach((tile) => {
          tile.classList.remove('is-open');
          tile.querySelector('[data-feature-trigger]')?.setAttribute('aria-expanded', 'false');
          const panel = tile.querySelector('[data-feature-panel]');
          if (panel) panel.hidden = true;
        });
        root.classList.remove('has-open-feature');
        history.replaceState(null, '', window.location.pathname);

        // Keep the closed tile in the same place on screen after layout shrinks.
        if (openTile && anchorTop != null) {
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              const delta = openTile.getBoundingClientRect().top - anchorTop;
              if (Math.abs(delta) > 0.5) {
                window.scrollBy({ top: delta, behavior: 'auto' });
              }
            });
          });
        }
      };

      root.querySelectorAll('[data-feature-trigger]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-feature-trigger');
          const tile = root.querySelector(`[data-feature-tile="${id}"]`);
          if (tile?.classList.contains('is-open')) {
            closeAll();
            return;
          }
          open(id, { scroll: true });
        });
      });

      const hash = location.hash.replace('#', '');
      if (hash && root.querySelector(`[data-feature-tile="${hash}"]`)) {
        open(hash, { scroll: true });
      }
    }
  </script>
</BaseLayout>
