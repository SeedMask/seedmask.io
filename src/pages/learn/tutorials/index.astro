---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="SeedMask tutorials — Learn"
  description="SeedMask setup and air-gapped signing tutorials — hardware preview setup, Coordinator pairing, and offline sends."
>
  <section class="page-hero page-hero-learn">
    <div class="container">
      <p class="eyebrow">Learn · Tutorials</p>
      <h1>SeedMask tutorials</h1>
      <p>Practical walkthroughs for the full loop — hardware preview, Coordinator, and air-gapped signing.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container tut-grid-cards">
      <a class="tut-card" href="/learn/tutorials/unbox-first-boot">
        <div class="tut-card-media">
          <img src="/illustrations/tut-card-unbox-4.png" alt="" />
        </div>
        <div class="tut-card-body">
          <span class="learn-card-meta">01 · Hardware preview</span>
          <h3>Hardware preview setup</h3>
          <p>
            Get the ESP32-S3 3.5B-C board, flash from Features → Firmware, reboot, then complete first wallet
            setup.
          </p>
          <span class="learn-card-cta">Open tutorial →</span>
        </div>
      </a>
      <a class="tut-card" href="/learn/tutorials/connect-coordinator">
        <div class="tut-card-media">
          <img src="/illustrations/tut-card-connect-11.png" alt="" />
        </div>
        <div class="tut-card-body">
          <span class="learn-card-meta">02 · Coordinator</span>
          <h3>Connect Coordinator</h3>
          <p>Create a watch-only Bitcoin or Kaspa wallet on desktop without importing private keys.</p>
          <span class="learn-card-cta">Open tutorial →</span>
        </div>
      </a>
      <a class="tut-card" href="/learn/tutorials/air-gapped-send">
        <div class="tut-card-media">
          <img src="/illustrations/tut-card-airgap.png" alt="" />
        </div>
        <div class="tut-card-body">
          <span class="learn-card-meta">03 · Signing</span>
          <h3>Air-gapped send</h3>
          <p>Build an unsigned transaction, sign on SeedMask, return the signed transaction, and broadcast when you choose.</p>
          <span class="learn-card-cta">Open tutorial →</span>
        </div>
      </a>
    </div>
    <div class="container" style="margin-top: 40px">
      <a class="btn btn-ghost" href="/learn">← Learn hub</a>
    </div>
  </section>
</BaseLayout>
