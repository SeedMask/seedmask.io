---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TutorialWalkthrough from '../../../components/TutorialWalkthrough.astro';

const steps = [
  {
    title: 'Download the app',
    body: 'Get SeedMask Coordinator from the App download page. Install it like any desktop app, then open it on a machine you use for everyday browsing — keys still stay on SeedMask.',
    graphic: 'download' as const,
  },
  {
    title: 'Create a watch-only wallet',
    body: `On SeedMask device (but currently ESP32-S3 3.5B-C), go to Bitcoin/Kaspa menu → Export xPub/kPub → choose the corresponding type.

In Coordinator, go to <strong>+</strong> → Connect software → Airgapped → SeedMask → click the QR icon. Point the QR code from Export xPub/kPub → Add wallet. (Don’t forget to name your wallet.)

<span class="tut-walk-warn">SeedMask Coordinator never asks for a seed. If it does, stop.</span>`,
    graphic: 'export' as const,
  },
  {
    title: 'Confirm balances and addresses',
    body: `Once synced, check that receive addresses shown in Coordinator match what SeedMask displays for the same account. You can do this by going to Kaspa/Bitcoin menu → Receive.

Label wallets clearly (for example Travel Fund / Savings).`,
    graphic: 'confirm' as const,
  },
  {
    title: 'Coordinator stays watch-only',
    body: `Coordinator can build unsigned transactions and track history. It cannot authorize spends. The cold wallet is the only signer, and as such has to be treated with care.

There is no way for Coordinator to sign — it has no hot wallet, and the key always stays on the cold wallet.`,
    graphic: 'watchonly' as const,
  },
];
---

<BaseLayout
  title="Connect Coordinator — SeedMask Tutorials"
  description="Set up SeedMask Coordinator as a watch-only desktop wallet for Bitcoin and Kaspa."
>
  <div class="tut-detail-fit">
  <section class="page-hero page-hero-learn">
    <div class="container learn-article-head">
      <p class="eyebrow">Tutorials · 02</p>
      <h1>Connect Coordinator</h1>
      <p>Pair a watch-only desktop workspace without ever importing your seed.</p>
      <div class="learn-meta-row">
        <span>~12 min</span>
        <span>Coordinator</span>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <TutorialWalkthrough steps={steps} />
    </div>
  </section>
  </div>
</BaseLayout>
